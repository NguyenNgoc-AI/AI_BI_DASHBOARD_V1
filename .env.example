# =============================================================================
# AI BI Dashboard - Cấu hình Biến Môi Trường (.env)
# =============================================================================

APP_ENV=development
APP_NAME="AI BI Dashboard API"
API_PORT=8000

# Security: JWT Token Secret (Tối thiểu 32 ký tự trong môi trường production)
JWT_SECRET=development-only-change-me-32-chars-long-secret
JWT_EXP_MINUTES=60

# Database: SQLite path
DATABASE_PATH=data/warehouse/app_database.db

# CORS: Danh sách domain được phép truy cập, phân cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8501

# Giới hạn dung lượng tải lên và số dòng
MAX_UPLOAD_BYTES=10485760
MAX_ROWS=100000

# Tài khoản Admin mặc định ban đầu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin-password-2026

# Cấu hình AI LLM Provider: deterministic | openai | gemini | llama
LLM_PROVIDER=deterministic
LLM_TIMEOUT_SECONDS=30

# API Keys cho LLM (khi không dùng deterministic)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLAMA_BASE_URL=
LLAMA_MODEL=llama3.1

