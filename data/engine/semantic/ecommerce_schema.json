    "COGS": {
      "metric_name": "Cost of Goods Sold",
      "code": "COGS",
      "unit": "USD",
      "category": "Cost & Profitability",
      "description": "Direct cost attributable to the production or acquisition of products sold.",
      "formula": "SUM(sales.quantity * products.unit_cost)",
      "sql_expression": "SELECT SUM(s.quantity * p.unit_cost) AS cogs FROM sales s JOIN products p ON s.product_id = p.product_id JOIN orders o ON s.order_id = o.order_id WHERE o.order_status NOT IN ('canceled', 'unavailable')",
      "aliases": ["cogs", "giá vốn hàng bán", "tổng giá vốn", "chi phí giá vốn", "chi phí vốn"]
