      "formula": "SUM(sales.gross_sales - sales.discount_amount)",
      "sql_expression": "SELECT SUM(s.gross_sales - s.discount_amount) AS net_revenue FROM sales s JOIN orders o ON s.order_id = o.order_id WHERE o.order_status NOT IN ('canceled', 'unavailable')",
      "aliases": ["net_revenue", "net_sales", "doanh thu thuần", "doanh số thuần", "doanh thu thực tế"]
