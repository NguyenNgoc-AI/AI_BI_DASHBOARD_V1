    "Gross_Profit": {
      "metric_name": "Gross Profit",
      "code": "Gross_Profit",
      "unit": "USD",
      "category": "Cost & Profitability",
      "description": "Profit earned after subtracting cost of goods sold from net revenue.",
      "formula": "Net_Revenue - COGS",
      "sql_expression": "SELECT (SUM(s.gross_sales - s.discount_amount) - SUM(s.quantity * p.unit_cost)) AS gross_profit FROM sales s JOIN products p ON s.product_id = p.product_id JOIN orders o ON s.order_id = o.order_id WHERE o.order_status NOT IN ('canceled', 'unavailable')",
      "aliases": ["gross_profit", "lợi nhuận gộp", "lãi gộp", "lợi nhuận trước chi phí vận hành"]
