          "example": "SALE_ITEM_1001"
        },
        "order_id": {
          "type": "string",
          "nullable": false,
          "semantic_type": "identifier",
          "description": "Foreign key reference to parent order.",
          "aliases": ["order_id", "mã đơn hàng", "mã đơn", "số đơn", "id đơn"],
          "example": "ORD_2023_88410"
        },
        "product_id": {
          "type": "string",
          "nullable": false,
          "semantic_type": "identifier",
          "description": "Foreign key reference to sold product SKU.",
          "aliases": ["product_id", "sku", "mã sản phẩm", "mã hàng", "id sản phẩm"],
          "example": "PROD_ELEC_9981"
        },
        "seller_id": {
          "type": "string",
          "nullable": true,
          "semantic_type": "identifier",
          "description": "Unique identifier for seller / vendor / store branch fulfilling the item.",
          "aliases": ["seller_id", "vendor_id", "mã người bán", "mã nhà bán hàng", "id gian hàng", "chi nhánh"],
          "example": "SELL_VN_042"
        },
        "quantity": {
          "type": "integer",
          "nullable": false,
          "semantic_type": "numerical_quantity",
          "description": "Number of units purchased in this order line item.",
          "aliases": ["quantity", "qty", "số lượng", "số lượng mua", "số lượng bán", "lượng hàng"],
          "example": 1
