  "semantic_metrics": {
    "GMV": {
      "metric_name": "Gross Merchandise Value",
      "code": "GMV",
      "unit": "USD",
      "category": "Sales & Revenue",
      "description": "Total monetary value of merchandise sold over a given period, including freight and before discount deductions.",
      "formula": "SUM(sales.gross_sales + sales.freight_value)",
      "sql_expression": "SELECT SUM(s.gross_sales + s.freight_value) AS gmv FROM sales s JOIN orders o ON s.order_id = o.order_id WHERE o.order_status NOT IN ('canceled', 'unavailable')",
      "aliases": ["gmv", "tổng giá trị giao dịch", "tổng doanh số hàng hóa", "tổng giá trị đơn hàng"]
