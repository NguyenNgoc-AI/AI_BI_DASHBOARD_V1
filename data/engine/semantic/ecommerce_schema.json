        "unit_price": {
          "type": "float",
          "nullable": false,
          "semantic_type": "numerical_currency",
          "unit": "USD",
          "description": "Actual unit selling price at transaction time.",
          "aliases": ["unit_price", "price", "đơn giá", "giá bán đơn vị", "giá thực bán"],
          "example": 99.99
        },
        "gross_sales": {
          "type": "float",
          "nullable": false,
          "semantic_type": "numerical_currency",
          "unit": "USD",
          "description": "Gross sales value before discount (quantity * unit_price).",
          "aliases": ["gross_sales", "total_price", "doanh thu gộp", "tổng tiền hàng", "doanh số thô", "tổng giá trị hàng"],
          "example": 99.99
        },
        "discount_amount": {
          "type": "float",
          "nullable": false,
          "semantic_type": "numerical_currency",
          "unit": "USD",
          "description": "Total coupon, voucher, or promotional discount applied to this line item.",
