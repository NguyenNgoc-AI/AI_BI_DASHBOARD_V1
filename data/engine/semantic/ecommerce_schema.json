{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_metadata": {
    "name": "ecommerce_bi_semantic_schema",
    "version": "1.0.0",
    "domain": "Retail & E-Commerce Business Intelligence",
    "description": "Standardized Semantic Schema for E-Commerce BI Dashboard, Synthetic Data Pipeline, and Text-to-SQL Engine across 5 core business entities: customers, products, orders, sales, and financials.",
    "created_at": "2026-10-04",
    "author": "Code Candy Team - AI BI Dashboard",
    "primary_currency": "USD",
    "timezone": "UTC"
  },
  "tables": {
    "customers": {
      "table_name": "customers",
      "description": "Customer entity profiles including demographics, geographic location, segmentation, and acquisition dates.",
      "primary_key": ["customer_id"],
      "foreign_keys": [],
      "columns": {
        "customer_id": {
          "type": "string",
          "nullable": false,
          "semantic_type": "identifier",
          "description": "Unique identifier for each customer.",
          "aliases": ["customer_id", "cust_id", "mã khách hàng", "mã khách", "id khách hàng", "user_id"],
          "example": "CUST_00010242"
        },
        "customer_name": {
          "type": "string",
          "nullable": false,
          "semantic_type": "text",
          "description": "Full name of the customer.",
          "aliases": ["customer_name", "name", "tên khách hàng", "họ tên", "tên người mua", "buyer_name"],
          "example": "Nguyen Van A"
        },
        "email": {
          "type": "string",
          "nullable": true,
          "semantic_type": "email",
          "description": "Email address of the customer.",
          "aliases": ["email", "mail", "email_address", "địa chỉ email", "thư điện tử"],
          "example": "customer.10242@example.com"
        },
        "city": {
          "type": "string",
          "nullable": true,
          "semantic_type": "categorical_geographic",
          "description": "City of customer residence or shipping destination.",
          "aliases": ["city", "thành phố", "tỉnh thành", "đô thị", "billing_city", "shipping_city"],
          "example": "Ho Chi Minh City"
        },
        "state": {
          "type": "string",
          "nullable": true,
          "semantic_type": "categorical_geographic",
          "description": "State / Province code or name.",
          "aliases": ["state", "province", "bang", "tỉnh", "tiểu bang", "khu vực"],
          "example": "SG"
        },
        "country": {
          "type": "string",
          "nullable": false,
          "semantic_type": "categorical_geographic",
          "description": "Country of the customer.",
          "aliases": ["country", "quốc gia", "đất nước", "nation"],
          "example": "Vietnam"
        },
        "zip_code": {
          "type": "string",
          "nullable": true,
          "semantic_type": "postal_code",
          "description": "Postal or ZIP code of customer address.",
          "aliases": ["zip_code", "postal_code", "mã bưu chính", "mã zip", "mã bưu điện"],
          "example": "70000"
        },
        "customer_segment": {
          "type": "string",
          "nullable": false,
          "semantic_type": "categorical",
          "allowed_values": ["Consumer", "Corporate", "Home Office", "VIP", "Wholesale"],
          "description": "Classification segment of the customer.",
          "aliases": ["customer_segment", "segment", "phân khúc khách hàng", "nhóm khách hàng", "loại khách hàng", "hạng thành viên"],
          "example": "Consumer"
        },
        "created_at": {
          "type": "datetime",
          "nullable": false,
          "semantic_type": "timestamp",
          "description": "Timestamp when the customer profile was created / first registered.",
          "aliases": ["created_at", "registration_date", "ngày tạo", "ngày đăng ký", "ngày gia nhập"],
          "example": "2023-01-15 08:30:00"
        }
      }
    },
    "products": {
      "table_name": "products",
      "description": "Product master catalog with SKU hierarchy, pricing, manufacturing/acquisition cost (COGS), and physical attributes.",
      "primary_key": ["product_id"],
      "foreign_keys": [],
      "columns": {
        "product_id": {
          "type": "string",
          "nullable": false,
          "semantic_type": "identifier",
          "description": "Unique identifier / SKU for each product.",
          "aliases": ["product_id", "sku", "mã sản phẩm", "mã hàng", "id sản phẩm", "item_code"],
          "example": "PROD_ELEC_9981"
        },
        "product_name": {
          "type": "string",
          "nullable": false,
          "semantic_type": "text",
          "description": "Commercial title or name of the product.",
          "aliases": ["product_name", "title", "item_name", "tên sản phẩm", "tên mặt hàng", "tên hàng hóa"],
          "example": "Wireless Noise Canceling Headphones"
        },
        "category": {
          "type": "string",
          "nullable": false,
          "semantic_type": "categorical",
          "allowed_values": [
            "Electronics",
            "Computers & Accessories",
            "Home & Kitchen",
            "Health & Personal Care",
            "Beauty & Fashion",
            "Sports & Outdoors",
            "Automotive",
            "Office Products",
            "Toys & Games",
            "Books"
          ],
          "description": "Primary high-level product category.",
          "aliases": ["category", "danh mục", "ngành hàng", "nhóm sản phẩm", "chủng loại"],
          "example": "Electronics"
        },
        "sub_category": {
          "type": "string",
          "nullable": true,
          "semantic_type": "categorical",
          "description": "Secondary detailed product sub-category.",
          "aliases": ["sub_category", "subcategory", "danh mục con", "phân nhóm", "nhóm phụ"],
          "example": "Audio & Video"
        },
        "unit_price": {
          "type": "float",
          "nullable": false,
          "semantic_type": "numerical_currency",
          "unit": "USD",
          "description": "Standard retail selling price per unit (excluding discounts and taxes).",
          "aliases": ["unit_price", "selling_price", "price", "giá bán", "đơn giá", "đơn giá bán", "giá niêm yết"],
          "example": 99.99
        },
        "unit_cost": {
          "type": "float",
          "nullable": false,
          "semantic_type": "numerical_currency",
          "unit": "USD",
          "description": "Cost of Goods Sold (COGS) / acquisition cost per unit.",
          "aliases": ["unit_cost", "cogs", "cost", "giá vốn", "giá nhập", "chi phí sản xuất", "đơn giá vốn", "chi phí sản phẩm"],
          "example": 45.50
        },
        "margin_rate": {
          "type": "float",
          "nullable": true,
          "semantic_type": "numerical_ratio",
          "unit": "percentage",
          "description": "Theoretical product profit margin rate ((unit_price - unit_cost) / unit_price).",
          "aliases": ["margin_rate", "profit_margin", "tỷ suất lợi nhuận", "biên lợi nhuận định mức", "margin"],
          "example": 0.545
        },
        "weight_g": {
          "type": "float",
          "nullable": true,
          "semantic_type": "numerical_quantity",
          "unit": "grams",
          "description": "Physical weight of the product in grams.",
          "aliases": ["weight_g", "weight", "khối lượng", "trọng lượng", "cân nặng"],
          "example": 280.0
        },
        "is_active": {
          "type": "boolean",
          "nullable": false,
          "semantic_type": "flag",
          "description": "Status flag indicating whether the product is currently active for sale.",
          "aliases": ["is_active", "status", "trạng thái kinh doanh", "đang bán", "active_flag"],
          "example": true
        }
      }
    },
    "orders": {
      "table_name": "orders",
      "description": "Order lifecycle events, delivery milestones, payment methods, and current order fulfillment status.",
      "primary_key": ["order_id"],
      "foreign_keys": [
        {
          "column": "customer_id",
          "references_table": "customers",
          "references_column": "customer_id",
          "relationship_type": "many_to_one"
        }
      ],
      "columns": {
        "order_id": {
          "type": "string",
          "nullable": false,
          "semantic_type": "identifier",
          "description": "Unique identifier for each transaction order.",
          "aliases": ["order_id", "mã đơn hàng", "mã đơn", "số đơn hàng", "id đơn hàng", "invoice_no"],
          "example": "ORD_2023_88410"
        },
        "customer_id": {
          "type": "string",
          "nullable": false,
          "semantic_type": "identifier",
          "description": "Foreign key reference to the purchasing customer in the customers table.",
          "aliases": ["customer_id", "cust_id", "mã khách hàng", "người mua", "id khách"],
          "example": "CUST_00010242"
        },
        "order_status": {
          "type": "string",
          "nullable": false,
          "semantic_type": "categorical",
          "allowed_values": [
            "delivered",
            "shipped",
            "invoiced",
            "processing",
            "created",
            "approved",
            "canceled",
            "unavailable",
            "returned"
          ],
          "description": "Current lifecycle status of the order.",
          "aliases": ["order_status", "status", "trạng thái đơn", "tình trạng đơn hàng", "trạng thái giao hàng", "tiến độ đơn"],
          "example": "delivered"
        },
        "order_purchase_timestamp": {
          "type": "datetime",
          "nullable": false,
          "semantic_type": "timestamp",
          "description": "Timestamp when the customer placed the order.",
          "aliases": ["order_purchase_timestamp", "order_date", "purchase_date", "ngày đặt hàng", "thời gian mua", "ngày mua", "thời điểm đặt"],
          "example": "2023-05-12 14:22:10"
        },
        "order_approved_at": {
          "type": "datetime",
          "nullable": true,
          "semantic_type": "timestamp",
          "description": "Timestamp when payment was approved and verified.",
          "aliases": ["order_approved_at", "approved_date", "ngày duyệt đơn", "thời gian xác nhận", "thời điểm thanh toán"],
          "example": "2023-05-12 14:35:00"
        },
        "order_delivered_carrier_date": {
          "type": "datetime",
          "nullable": true,
          "semantic_type": "timestamp",
          "description": "Timestamp when order was handed over to the logistics shipping carrier.",
          "aliases": ["order_delivered_carrier_date", "shipping_date", "ngày giao đơn vị vận chuyển", "ngày xuất kho", "thời gian gửi hàng"],
          "example": "2023-05-13 09:10:00"
        },
        "order_delivered_customer_date": {
          "type": "datetime",
          "nullable": true,
          "semantic_type": "timestamp",
          "description": "Timestamp when order was successfully delivered to the customer.",
          "aliases": ["order_delivered_customer_date", "delivery_date", "ngày giao thành công", "ngày nhận hàng", "thời gian giao tận nơi"],
          "example": "2023-05-16 16:45:22"
        },
        "order_estimated_delivery_date": {
          "type": "datetime",
          "nullable": true,
          "semantic_type": "timestamp",
          "description": "Estimated delivery date communicated to the customer upon purchase.",
          "aliases": ["order_estimated_delivery_date", "estimated_delivery", "ngày dự kiến giao", "hạn giao dự kiến", "thời hạn ước tính"],
          "example": "2023-05-18 00:00:00"
        },
        "payment_type": {
          "type": "string",
          "nullable": false,
          "semantic_type": "categorical",
          "allowed_values": [
            "credit_card",
            "debit_card",
            "boleto",
            "voucher",
            "e_wallet",
            "bank_transfer",
            "cod"
          ],
          "description": "Payment gateway / method used for settling the order.",
          "aliases": ["payment_type", "payment_method", "phương thức thanh toán", "hình thức trả tiền", "kênh thanh toán", "loại thanh toán"],
          "example": "credit_card"
        },
        "payment_installments": {
          "type": "integer",
          "nullable": false,
          "semantic_type": "numerical_quantity",
          "description": "Number of payment installments chosen (1 for full upfront payment).",
          "aliases": ["payment_installments", "installments", "số kỳ trả góp", "trả góp", "số đợt thanh toán"],
          "example": 1
        },
        "payment_value": {
          "type": "float",
          "nullable": false,
          "semantic_type": "numerical_currency",
          "unit": "USD",
          "description": "Total payment amount paid by customer for this order (including freight and vouchers).",
          "aliases": ["payment_value", "total_paid", "số tiền thanh toán", "tổng tiền thanh toán", "tiền trả", "giá trị đơn"],
          "example": 114.99
        }
      }
    },
    "sales": {
      "table_name": "sales",
      "description": "Granular order line item transactions detailing item quantity, selling price, discounts, freight, platform commissions, and net item sales.",
      "primary_key": ["sales_id"],
      "foreign_keys": [
        {
          "column": "order_id",
          "references_table": "orders",
          "references_column": "order_id",
          "relationship_type": "many_to_one"
        },
        {
          "column": "product_id",
          "references_table": "products",
          "references_column": "product_id",
          "relationship_type": "many_to_one"
        }
      ],
      "columns": {
        "sales_id": {
          "type": "string",
          "nullable": false,
          "semantic_type": "identifier",
          "description": "Unique identifier for each sales line item.",
