    "Net_Profit": {
      "metric_name": "Net Profit",
      "code": "Net_Profit",
      "unit": "USD",
      "category": "Financial Bottom-line",
      "description": "Bottom-line earnings remaining after deducting COGS, marketing ad spend, platform commissions, net logistics expenses, taxes, and operating overheads.",
      "formula": "Gross_Profit - Marketing_Spend - Platform_Fees - Shipping_Cost - Taxes - Operating_Expenses",
