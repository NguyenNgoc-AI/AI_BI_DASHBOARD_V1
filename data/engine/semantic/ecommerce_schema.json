          "example": 5.00
        },
        "freight_value": {
          "type": "float",
          "nullable": false,
          "semantic_type": "numerical_currency",
          "unit": "USD",
          "description": "Shipping and delivery fee charged for this item.",
          "aliases": ["freight_value", "shipping_fee", "phí vận chuyển", "tiền cước", "phí ship", "cước chuyển phát"],
          "example": 15.00
        },
        "platform_fee": {
          "type": "float",
          "nullable": false,
          "semantic_type": "numerical_currency",
          "unit": "USD",
          "description": "Marketplace platform commission / transaction fee paid per sale.",
          "aliases": ["platform_fee", "commission", "phí sàn", "phí hoa hồng sàn", "phí giao dịch", "chiết khấu sàn"],
          "example": 8.00
        },
        "net_sales": {
          "type": "float",
          "nullable": false,
          "semantic_type": "numerical_currency",
          "unit": "USD",
          "description": "Net sales revenue after discount deduction (gross_sales - discount_amount).",
