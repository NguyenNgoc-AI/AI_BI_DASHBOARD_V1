    "Gross_Revenue": {
      "metric_name": "Gross Revenue",
      "code": "Gross_Revenue",
      "unit": "USD",
      "category": "Sales & Revenue",
      "description": "Total top-line sales revenue before applying any discounts, returns, or deductions.",
      "formula": "SUM(sales.quantity * sales.unit_price)",
      "sql_expression": "SELECT SUM(s.quantity * s.unit_price) AS gross_revenue FROM sales s JOIN orders o ON s.order_id = o.order_id WHERE o.order_status NOT IN ('canceled', 'unavailable')",
      "aliases": ["gross_revenue", "doanh thu gộp", "tổng doanh thu bán hàng", "tổng tiền bán"]
