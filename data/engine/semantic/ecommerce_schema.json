    "Gross_Margin": {
      "metric_name": "Gross Margin Percentage",
      "code": "Gross_Margin",
      "unit": "percentage",
      "category": "Cost & Profitability",
      "description": "Percentage of net revenue retained as gross profit after paying direct production costs.",
      "formula": "(Gross_Profit / Net_Revenue) * 100",
      "sql_expression": "SELECT ((SUM(s.gross_sales - s.discount_amount) - SUM(s.quantity * p.unit_cost)) / NULLIF(SUM(s.gross_sales - s.discount_amount), 0)) * 100 AS gross_margin_pct FROM sales s JOIN products p ON s.product_id = p.product_id JOIN orders o ON s.order_id = o.order_id WHERE o.order_status NOT IN ('canceled', 'unavailable')",
      "aliases": ["gross_margin", "biên lợi nhuận gộp", "tỷ suất lợi nhuận gộp", "tỷ lệ lãi gộp"]
